# ──────────────────────────────────────────────
#  LUMEN — Environment Variables
#  Copy this file to .env.local and fill in your values.
#  .env.local is git-ignored and must NEVER be committed.
# ──────────────────────────────────────────────

# Public site URL (used for Open Graph / metadata)
# During local dev this can be left as-is or set to http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://cusor.me

# Analytics (optional — remove if unused)
# NEXT_PUBLIC_ANALYTICS_ID=

# Add any additional API keys below
# MY_SECRET_API_KEY=
